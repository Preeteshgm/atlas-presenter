{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    // esbuild does the resolving, so "bundler" is the mode that matches
    // reality. "node" resolves to node10, which TypeScript 5 deprecates and
    // editors underline.
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2020", "ES2022.Error"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
