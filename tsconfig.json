{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "importHelpers": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "lib": ["DOM", "ES2020", "ES2022.Error"]
  },
  "include": ["src/**/*.ts"]
}
